#!/bin/sh
set -e

# Debian Trixie moved Syslinux BIOS modules under /usr/lib/syslinux/modules/bios.
# live-build's legacy isolinux staging expects them under /lib/syslinux.
mkdir -p /lib/syslinux
ln -sf /usr/lib/ISOLINUX/isolinux.bin /lib/syslinux/isolinux.bin
for module in /usr/lib/syslinux/modules/bios/*.c32; do
    [ -e "$module" ] || continue
    ln -sf "$module" "/lib/syslinux/$(basename "$module")"
done
